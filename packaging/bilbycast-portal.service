[Unit]
Description=bilbycast viewer portal (DVR)
Documentation=https://bilbycast.com/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user, NOT the relay's. The portal is public-facing and the relay
# terminates media for every viewer on this box; sharing an account would mean
# a portal compromise could read the relay's config and its manager secret.
User=bilbycast-portal
Group=bilbycast-portal
WorkingDirectory=/var/lib/bilbycast/portal

ExecStart=/opt/bilbycast/portal/bilbycast-portal --config /etc/bilbycast/portal.json

Restart=always
RestartSec=3
StartLimitInterval=300
StartLimitBurst=10

KillSignal=SIGTERM
TimeoutStopSec=10

# ── Hardening ──
# Stricter than the relay's, because the portal does even less: it reads one
# config file, listens on loopback, and makes outbound HTTPS calls to the
# manager and to Authelia. It writes to one place, and only when account sync
# (the optional `accounts` block) is configured: Authelia's users directory.
ProtectSystem=strict
# Read-only, unlike the relay's: the portal holds no node identity to write
# back, so a writable /etc/bilbycast would only widen what a compromise could
# reach.
ReadOnlyPaths=/etc/bilbycast
# Account sync replaces Authelia's user file by writing a temp file beside it
# and renaming it over the original, so it needs the directory, not just the
# file. Whatever can write here can add or change Authelia accounts, which is
# why it is this directory and nothing else. The `-` lets a portal without
# account sync, and so without the directory, start; it also means a directory
# created after the portal started stays read-only until a restart. A
# users_file anywhere else needs its own ReadWritePaths= in a drop-in
# (`systemctl edit bilbycast-portal`), never an edit here: install-relay.sh
# --with-portal and upgrade-relay.sh both replace this file with the packaged
# one, and keep drop-ins. Not under /home or /tmp: those are hidden below.
ReadWritePaths=-/etc/authelia/users
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
NoNewPrivileges=true
# Loopback :8088 by default — above 1024, no capability needed.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Given back after the line above takes it away. Account sync keeps the users
# file's group across a rewrite with fchown, and a call this filter denies does
# not fail, it kills the process. With no capabilities (above), it can only
# hand a file the portal owns to a group the portal is already in.
SystemCallFilter=@chown

# One viewer at a time clicking a link. Nothing like the relay's connection
# count, so the default ceiling is ample and left alone.

# The manager service token lives here, not in portal.json, so it can be mode
# 0600 root:bilbycast-portal and stay out of any config file that gets copied
# around while someone is debugging. Set BILBYCAST_PORTAL_TOKEN in it.
EnvironmentFile=/etc/bilbycast/portal.env

[Install]
WantedBy=multi-user.target
